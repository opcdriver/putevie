<Window x:Class="Putevie.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Putevie.Converters"
        mc:Ignorable="d"
        Title="Генератор колійних листів"
        Height="900"
        Width="1400"
        MinHeight="700"
        MinWidth="1100"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="Генератор колійних листів"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Дані авто" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Автомобіль" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding VehicleName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FluentTextBoxStyle}" />
                        <TextBlock Text="Рік випуску" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding YearOfManufacture, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FluentTextBoxStyle}" />
                        <TextBlock Text="Державний номер" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FluentTextBoxStyle}" />
                        <TextBlock Text="Тип двигуна" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding EngineTypes}"
                                  SelectedItem="{Binding SelectedEngineType}"
                                  Style="{StaticResource FluentComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EngineTypeConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Обʼєм двигуна, см³" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding EngineVolumeCc, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FluentTextBoxStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Дані працівника" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Працівник (ПІБ)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FluentTextBoxStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Вхідні дані для розрахунку" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Остання дата колійного листа" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding LastWaybillDate}"
                                    Style="{StaticResource FluentDatePickerStyle}" />
                        <TextBlock Text="Залишок палива в баку (л)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding FuelRemainingAtLastDate, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                 Style="{StaticResource FluentTextBoxStyle}" />
                        <TextBlock Text="Дата, до якої генерувати листи" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker SelectedDate="{Binding GenerateUntilDate}"
                                    Style="{StaticResource FluentDatePickerStyle}" />
                        <TextBlock Text="Норма витрати палива на 100 км (л)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding FuelConsumptionNorm, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                 Style="{StaticResource FluentTextBoxStyle}" />
                        <TextBlock Text="Початковий одометр (км)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding InitialOdometer, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FluentTextBoxStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Дати заправок" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                            <Button Content="+ Додати заправку"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{Binding AddRefuelCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RefuelEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Grid.Column="0"
                                                        SelectedDate="{Binding Date, Mode=TwoWay}"
                                                        Margin="0,0,8,0" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Liters, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                     Margin="0,0,8,0"
                                                     Padding="8,6"
                                                     ToolTip="Кількість літрів" />
                                            <Button Grid.Column="2"
                                                    Content="Видалити"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding DataContext.RemoveRefuelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Вихідні дні (не генерувати)" Style="{StaticResource SectionTitleStyle}" />
                        <WrapPanel>
                            <CheckBox Content="Пн" IsChecked="{Binding SkipMonday}" Margin="0,0,16,8" />
                            <CheckBox Content="Вт" IsChecked="{Binding SkipTuesday}" Margin="0,0,16,8" />
                            <CheckBox Content="Ср" IsChecked="{Binding SkipWednesday}" Margin="0,0,16,8" />
                            <CheckBox Content="Чт" IsChecked="{Binding SkipThursday}" Margin="0,0,16,8" />
                            <CheckBox Content="Пт" IsChecked="{Binding SkipFriday}" Margin="0,0,16,8" />
                            <CheckBox Content="Сб" IsChecked="{Binding SkipSaturday}" Margin="0,0,16,8" />
                            <CheckBox Content="Нд" IsChecked="{Binding SkipSunday}" Margin="0,0,16,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Button Content="Згенерувати колійні листи"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding GenerateCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,16"
                    Visibility="{Binding WarningsText, Converter={x:Static converters:StringNotEmptyToVisibilityConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="Попередження"
                               FontWeight="SemiBold"
                               Foreground="#C42B1C"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding WarningsText}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Результати генерації"
                               Style="{StaticResource SectionTitleStyle}" />
                    <DataGrid ItemsSource="{Binding GeneratedWaybills}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding DateDisplay}" Width="100" />
                            <DataGridTextColumn Header="Працівник" Binding="{Binding EmployeeName}" Width="160" />
                            <DataGridTextColumn Header="Авто" Binding="{Binding VehicleName}" Width="120" />
                            <DataGridTextColumn Header="Номер" Binding="{Binding LicensePlate}" Width="90" />
                            <DataGridTextColumn Header="Пробіг" Binding="{Binding DistanceDisplay}" Width="80" />
                            <DataGridTextColumn Header="Одометр" Binding="{Binding OdometerDisplay}" Width="130" />
                            <DataGridTextColumn Header="Заправка" Binding="{Binding RefuelDisplay}" Width="80" />
                            <DataGridTextColumn Header="Витрата (л)" Binding="{Binding FuelConsumptionDisplay}" Width="90" />
                            <DataGridTextColumn Header="Паливо в баку" Binding="{Binding FuelDisplay}" Width="120" />
                            <DataGridTextColumn Header="Температура" Binding="{Binding TemperatureDisplay}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
